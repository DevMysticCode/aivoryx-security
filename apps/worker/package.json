    "@aivoryx/scanner-core": "workspace:*",
    "@aivoryx/scanner-web-discovery": "workspace:*",
    "@aivoryx/shared-types": "workspace:*",
    "bullmq": "^5.28.1",
    "drizzle-orm": "^0.36.1"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.7.5",
    "vitest": "^2.1.4"
