{
  "name": "@aivoryx/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "dev": "node --watch dist/index.js",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@aivoryx/config": "workspace:*",
    "@aivoryx/logger": "workspace:*",
    "@aivoryx/db": "workspace:*",
    "@aivoryx/queue": "workspace:*",
    "@aivoryx/auth": "workspace:*",
    "@aivoryx/shared-types": "workspace:*",
    "fastify": "^5.1.0",
    "@fastify/helmet": "^12.0.1",
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^10.1.1",
    "drizzle-orm": "^0.36.1",
    "bullmq": "^5.28.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.7.5",
    "vitest": "^2.1.4"
