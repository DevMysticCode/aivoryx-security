# ---------------------------------------------------------------------------
# Aivoryx Tester — environment configuration
# Copy to .env and fill in real values. Never commit .env.
# Parsed and validated by @aivoryx/config (packages/config/src) — see that
# package for exact validation rules and defaults.
# ---------------------------------------------------------------------------

# --- Application -------------------------------------------------------------
NODE_ENV=development
APP_ENV=development
APP_NAME=aivoryx-tester
API_PORT=4000
# debug | info | warn | error | silent. Defaults by NODE_ENV if unset
# (development=debug, test=silent, production=info).
# LOG_LEVEL=debug

# --- URLs ----------------------------------------------------------------------
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000
# Worker/service -> API URL. Falls back to PUBLIC_API_URL when unset.
# INTERNAL_API_URL=http://api:4000

# --- Database --------------------------------------------------------------------
# Required in all environments (no default).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aivoryx
# Used only by docker-compose (infrastructure/docker/docker-compose.yml) to
# provision the local Postgres container. Keep in sync with DATABASE_URL above.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aivoryx
POSTGRES_PORT=5432

# --- Redis / Queue -----------------------------------------------------------------
# Required in all environments (no default).
REDIS_URL=redis://localhost:6379
# Used only by docker-compose to provision the local Redis container.
REDIS_PORT=6379

# --- Authentication ------------------------------------------------------------------
# Required in production; an insecure development-only default is used if unset
# outside production. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=15m

# --- Security --------------------------------------------------------------------------
# Required in production; an insecure development-only default is used if unset
# outside production. Generate with: openssl rand -hex 32
CREDENTIAL_MASTER_KEY=
# Must stay false in production; only for isolated local scan-target testing.
SSRF_ALLOW_PRIVATE_RANGES=false
SCAN_ALLOWED_PORTS=80,443,8080,8443
SCAN_TIMEOUT_MS=120000
MAX_RESPONSE_BYTES=1000000
WORKER_CONCURRENCY=2

# --- AI (optional, disabled by default) -------------------------------------------------
AI_ENABLED=false
# AI_PROVIDER=groq
# AI_MODEL=llama-3.1-8b-instant
# AI_API_KEY=
# AI_BASE_URL=http://localhost:11434
