{
  "name": "@aivoryx/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node ./dist/migrate-cli.js"
  },
  "dependencies": {
    "@aivoryx/config": "workspace:*",
    "@aivoryx/shared-types": "workspace:*",
    "drizzle-orm": "^0.36.1",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.7.5",
    "vitest": "^2.1.4",
    "drizzle-kit": "^0.28.0"
  }
}
